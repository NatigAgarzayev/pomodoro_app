{
    "expo": {
        "scheme": "pomodoro-app",
        "name": "Pomodoro",
        "slug": "pomodoro_app",
        "version": "1.3.0",
        "orientation": "portrait",
        "icon": "./assets/splashlightfixed.png",
        "userInterfaceStyle": "automatic",
        "newArchEnabled": true,
        "splash": {
            "image": "./assets/splashlightfixed.png",
            "resizeMode": "contain",
            "backgroundColor": "#ffffff"
        },
        "ios": {
            "supportsTablet": true,
            "splash": {
                "image": "./assets/splashlightfixed.png",
                "resizeMode": "contain",
                "backgroundColor": "#ffffff",
                "dark": {
                    "image": "./assets/splashdarkfixed.png",
                    "backgroundColor": "#000000"
                }
            }
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/splashlightfixed.png",
                "backgroundColor": "#ffffff"
            },
            "splash": {
                "image": "./assets/splashlightfixed.png",
                "resizeMode": "contain",
                "backgroundColor": "#ffffff",
                "dark": {
                    "image": "./assets/splashdarkfixed.png",
                    "backgroundColor": "#000000"
                }
            },
            "edgeToEdgeEnabled": true,
            "predictiveBackGestureEnabled": false,
            "permissions": [
                "android.permission.RECORD_AUDIO",
                "android.permission.MODIFY_AUDIO_SETTINGS"
            ],
            "package": "com.anonymous.pomodoroapp"
        },
        "web": {
            "favicon": "./assets/favicon.png"
        },
        "plugins": [
            "expo-router",
            "expo-audio",
            "expo-splash-screen"
        ],
        "extra": {
            "router": {},
            "eas": {
                "projectId": "a799f239-5c64-4ba8-82ff-a496da633e1f"
            }
        }
    }
}